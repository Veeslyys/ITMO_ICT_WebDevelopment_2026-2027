0435\u043b\u044c \u0440\u0430\u0431\u043e\u0442\u044b \u0418\u0437\u0443\u0447\u0438\u0442\u044c \u043e\u0441\u043d\u043e\u0432\u044b \u0440\u0430\u0431\u043e\u0442\u044b \u0441 \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u043e\u0439 socket \u0432 Python \u0438 \u0440\u0435\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u0442\u044c \u043f\u0440\u043e\u0441\u0442\u044b\u0435 \u043a\u043b\u0438\u0435\u043d\u0442-\u0441\u0435\u0440\u0432\u0435\u0440\u043d\u044b\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0441 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435\u043c \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u043e\u0432 UDP, TCP \u0438 HTTP. \u0421\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0430 \u043f\u0440\u043e\u0435\u043a\u0442\u0430 lab1_sockets/ \u251c\u2500\u2500 task1_udp/ \u2502 \u251c\u2500\u2500 udp_server.py \u2502 \u2514\u2500\u2500 udp_client.py \u251c\u2500\u2500 task2_tcp_math/ \u2502 \u251c\u2500\u2500 tcp_math_server.py \u2502 \u2514\u2500\u2500 tcp_math_client.py \u251c\u2500\u2500 task3_http_file/ \u2502 \u251c\u2500\u2500 http_server.py \u2502 \u2514\u2500\u2500 index.html \u251c\u2500\u2500 task4_chat/ \u2502 \u251c\u2500\u2500 chat_server.py \u2502 \u2514\u2500\u2500 chat_client.py \u251c\u2500\u2500 task5_web_grades/ \u2502 \u2514\u2500\u2500 web_grades_server.py \u251c\u2500\u2500 README.md \u2514\u2500\u2500 report.txt \u0417\u0430\u0434\u0430\u043d\u0438\u0435 1. UDP \u043a\u043b\u0438\u0435\u043d\u0442 \u0438 \u0441\u0435\u0440\u0432\u0435\u0440 \u0420\u0435\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u044b UDP-\u0441\u0435\u0440\u0432\u0435\u0440 \u0438 UDP-\u043a\u043b\u0438\u0435\u043d\u0442. \u041a\u043b\u0438\u0435\u043d\u0442 \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0442 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435 Hello, server , \u0441\u0435\u0440\u0432\u0435\u0440 \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0435\u0442 \u0435\u0433\u043e, \u0432\u044b\u0432\u043e\u0434\u0438\u0442 \u0432 \u043a\u043e\u043d\u0441\u043e\u043b\u044c \u0438 \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0442 \u043e\u0442\u0432\u0435\u0442 Hello, client . \u0424\u0430\u0439\u043b\u044b: lab1_sockets/task1_udp/udp_server.py lab1_sockets/task1_udp/udp_client.py \u0417\u0430\u043f\u0443\u0441\u043a: cd lab1_sockets/task1_udp python3 udp_server.py python3 udp_client.py \u0417\u0430\u0434\u0430\u043d\u0438\u0435 2. TCP \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0435 \u0433\u0438\u043f\u043e\u0442\u0435\u043d\u0443\u0437\u044b \u0420\u0435\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u044b TCP-\u0441\u0435\u0440\u0432\u0435\u0440 \u0438 TCP-\u043a\u043b\u0438\u0435\u043d\u0442 \u0434\u043b\u044f \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f \u0433\u0438\u043f\u043e\u0442\u0435\u043d\u0443\u0437\u044b \u043f\u043e \u0442\u0435\u043e\u0440\u0435\u043c\u0435 \u041f\u0438\u0444\u0430\u0433\u043e\u0440\u0430. \u041a\u043b\u0438\u0435\u043d\u0442 \u0432\u0432\u043e\u0434\u0438\u0442 \u0434\u0432\u0430 \u043a\u0430\u0442\u0435\u0442\u0430, \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0442 \u0438\u0445 \u0441\u0435\u0440\u0432\u0435\u0440\u0443, \u0441\u0435\u0440\u0432\u0435\u0440 \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0435\u0442 \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0435 \u0438 \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442. \u0424\u0430\u0439\u043b\u044b: lab1_sockets/task2_tcp_math/tcp_math_server.py lab1_sockets/task2_tcp_math/tcp_math_client.py \u0417\u0430\u043f\u0443\u0441\u043a: cd lab1_sockets/task2_tcp_math python3 tcp_math_server.py python3 tcp_math_client.py \u0417\u0430\u0434\u0430\u043d\u0438\u0435 3. \u041f\u0440\u043e\u0441\u0442\u043e\u0439 HTTP-\u0441\u0435\u0440\u0432\u0435\u0440 \u0420\u0435\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d HTTP-\u0441\u0435\u0440\u0432\u0435\u0440, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u0440\u0438 \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0438 \u043a\u043b\u0438\u0435\u043d\u0442\u0430 \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0442 HTML-\u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0443 \u0438\u0437 \u0444\u0430\u0439\u043b\u0430 index.html . \u0424\u0430\u0439\u043b\u044b: lab1_sockets/task3_http_file/http_server.py lab1_sockets/task3_http_file/index.html \u0417\u0430\u043f\u0443\u0441\u043a: cd lab1_sockets/task3_http_file python3 http_server.py \u041f\u043e\u0441\u043b\u0435 \u0437\u0430\u043f\u0443\u0441\u043a\u0430 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0430 \u043f\u043e \u0430\u0434\u0440\u0435\u0441\u0443: http://127.0.0.1:8080 \u0417\u0430\u0434\u0430\u043d\u0438\u0435 4. \u041c\u043d\u043e\u0433\u043e\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0438\u0439 \u0447\u0430\u0442 \u0420\u0435\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d \u043c\u043d\u043e\u0433\u043e\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0438\u0439 TCP-\u0447\u0430\u0442. \u0421\u0435\u0440\u0432\u0435\u0440 \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0435\u0442 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0439, \u0441\u043e\u0437\u0434\u0430\u0435\u0442 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0439 \u043f\u043e\u0442\u043e\u043a \u0434\u043b\u044f \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u043a\u043b\u0438\u0435\u043d\u0442\u0430 \u0438 \u043f\u0435\u0440\u0435\u0441\u044b\u043b\u0430\u0435\u0442 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u044f \u0434\u0440\u0443\u0433\u0438\u043c \u0443\u0447\u0430\u0441\u0442\u043d\u0438\u043a\u0430\u043c. \u0424\u0430\u0439\u043b\u044b: lab1_sockets/task4_chat/chat_server.py lab1_sockets/task4_chat/chat_client.py \u0417\u0430\